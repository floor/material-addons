      "import": "./dist/components/breadcrumb/index.mjs"
    },
    "./components/breadcrumb/constants": {
      "types": "./dist/components/breadcrumb/constants.d.ts",
      "import": "./dist/components/breadcrumb/constants.mjs"
    },
    "./components/skeleton": {
      "types": "./dist/components/skeleton/index.d.ts",
      "import": "./dist/components/skeleton/index.mjs"
    },
    "./components/skeleton/constants": {
      "types": "./dist/components/skeleton/constants.d.ts",
      "import": "./dist/components/skeleton/constants.mjs"
    },
    "./components/tree": {
