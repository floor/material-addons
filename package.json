    },
    "./components/navigation-tabs": {
      "types": "./dist/components/navigation-tabs/index.d.ts",
      "import": "./dist/components/navigation-tabs/index.mjs"
    },
    "./components/rating": {
      "types": "./dist/components/rating/index.d.ts",
      "import": "./dist/components/rating/index.mjs"
    },
    "./elements/navigation-tabs": {
      "types": "./dist/elements/navigation-tabs.d.ts",
      "import": "./dist/elements/navigation-tabs.mjs"
