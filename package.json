    },
    "./elements/css/autocomplete": {
      "types": "./dist/elements/autocomplete-css.d.ts",
      "import": "./dist/elements/autocomplete-css.mjs"
    },
    "./components/avatar": {
      "types": "./dist/components/avatar/index.d.ts",
