    },
    "./components/alert": {
      "types": "./dist/components/alert/index.d.ts",
      "import": "./dist/components/alert/index.mjs"
    },
    "./elements/alert": {
      "types": "./dist/elements/alert.d.ts",
      "import": "./dist/elements/alert.mjs"
    },
    "./elements/css/alert": {
      "types": "./dist/elements/css/alert.d.ts",
      "import": "./dist/elements/css/alert.js"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.js",
    "dev": "bun run ./scripts/build.js --watch",
    "ts:check": "tsc --noEmit -p scripts/tsconfig.check.json",
    "bench": "ADDONS_BENCH=1 bun test test/benchmarks/",
    "test": "bun test",
    "prepublishOnly": "bun run adapters:check && bun run ts:check && bun test && bun run build --production && bun run check:package && bun run readme:check && bun run check:stepper && bun run check:stepper-adapters && bun run check:autocomplete && bun run check:expansion-panel && bun run check:avatar && bun run check:paginator && bun run check:breadcrumb && bun run check:alert && bun run check:rating",
    "release:pack": "bun run prepublishOnly && node scripts/release-pack.mjs",
    "link:material": "node scripts/link-material.mjs",
    "check:package": "node scripts/check-package.mjs",
    "readme:check": "node scripts/check-readme.mjs",
    "check:stepper": "node scripts/check-stepper.mjs",
    "check:skeleton": "node scripts/check-skeleton.mjs",
    "check:skeleton-adapters": "node scripts/check-skeleton-adapters.mjs",
    "check:tree": "node scripts/check-tree.mjs",
    "check:navigation-tabs": "node scripts/check-navigation-tabs.mjs",
    "check:avatar": "node scripts/check-avatar.mjs",
    "check:alert": "node scripts/check-alert.mjs",
    "check:rating": "node scripts/check-rating.mjs",
    "check:autocomplete": "node scripts/check-autocomplete.mjs",
    "adapters:generate": "bun scripts/generate-adapters.mjs",
    "adapters:check": "bun scripts/generate-adapters.mjs --check",
    "check:stepper-adapters": "node scripts/check-stepper-adapters.mjs",
    "check:expansion-panel": "node scripts/check-expansion-panel.mjs",
    "check:paginator": "node scripts/check-paginator.mjs",
    "check:breadcrumb": "node scripts/check-breadcrumb.mjs",
    "check:data-grid": "node scripts/check-data-grid.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floor/material-addons.git"
  },
  "keywords": [
    "mtrl",
    "addons",
    "components",
    "forms",
    "ui"
  ],
  "author": "floor",
  "license": "MIT",
  "peerDependencies": {
    "material": "^3.15.1",
    "react": ">=18",
    "vue": ">=3.4.20",
    "svelte": ">=5",
    "solid-js": ">=1.8 <2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "bun-types": "^1.0.0",
    "jsdom": "^26.1.0",
    "madge": "^8.0.0",
    "material": "3.15.1",
    "playwright": "^1.63.0",
    "sass": "^1.94.2",
    "standard": "^17.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "solid-js": "^1.9",
    "svelte": "^5",
    "vue": "^3.5"
  },
  "bugs": {
    "url": "https://github.com/floor/material-addons/issues"
  },
  "homepage": "https://github.com/floor/material-addons#readme",
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
