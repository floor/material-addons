    },
    "./components/tree/constants": {
      "types": "./dist/components/tree/constants.d.ts",
      "import": "./dist/components/tree/constants.mjs"
    },
    "./components/tree/virtual": {
      "types": "./dist/components/tree/virtual.d.ts",
      "import": "./dist/components/tree/virtual.mjs"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.mjs"
    },
    "./elements/stepper": {
      "types": "./dist/elements/stepper.d.ts",
      "import": "./dist/elements/stepper.mjs"
    },
    "./elements/paginator": {
      "types": "./dist/elements/paginator.d.ts",
      "import": "./dist/elements/paginator.mjs"
    },
    "./elements/breadcrumb": {
      "types": "./dist/elements/breadcrumb.d.ts",
      "import": "./dist/elements/breadcrumb.mjs"
    },
    "./elements/skeleton": {
      "types": "./dist/elements/skeleton.d.ts",
      "import": "./dist/elements/skeleton.mjs"
    },
    "./elements/tree": {
      "types": "./dist/elements/tree.d.ts",
      "import": "./dist/elements/tree.mjs"
    },
    "./elements/css/stepper": {
      "types": "./dist/elements/css/stepper.d.ts",
      "import": "./dist/elements/css/stepper.js"
    },
    "./elements/css/paginator": {
      "types": "./dist/elements/css/paginator.d.ts",
      "import": "./dist/elements/css/paginator.js"
    },
    "./elements/css/breadcrumb": {
      "types": "./dist/elements/css/breadcrumb.d.ts",
      "import": "./dist/elements/css/breadcrumb.js"
    },
    "./elements/css/skeleton": {
      "types": "./dist/elements/css/skeleton.d.ts",
      "import": "./dist/elements/css/skeleton.js"
    },
    "./elements/css/tree": {
      "types": "./dist/elements/css/tree.d.ts",
      "import": "./dist/elements/css/tree.js"
    },
    "./components/autocomplete": {
      "types": "./dist/components/autocomplete/index.d.ts",
      "import": "./dist/components/autocomplete/index.mjs"
    },
    "./elements/autocomplete": {
      "types": "./dist/elements/autocomplete.d.ts",
